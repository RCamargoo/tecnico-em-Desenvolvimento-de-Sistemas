programa {
  funcao inicio() {
    
    real baseMaior,basemenor,altura,area

    escreva("baseMaior")
    leia(baseMaior)

    escreva("basemenor")
    leia(basemenor)

    escreva("altura")
    leia(altura)

    area=((baseMaior+basemenor)*altura)/2

    escreva("aréa do trapezio:",area)

      }
}
