programa {
  funcao inicio() {
    inteiro n1, n2

    escreva("digite o n1: ")
    leia(n1)

    escreva("digite o n2: ")
    leia(n2)

    se(n1>n2){
    escreva("O ",n1, " maior")
    }

    senao se(n2>n1){
    escreva("O",n2," maior")
    }

    senao se(n1 == n2){
    escreva("os numeros são iguais")
    
    }






    
  }
}
