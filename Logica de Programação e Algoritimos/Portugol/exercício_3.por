programa {
  funcao inicio() {
    inteiro n

    escreva("digite o numero de 1 a 7: ")
    leia(n)

    se(n == 1){
      escreva("domingo")
    }
    senao se(n == 2){
      escreva("segunda-feira")
    }
       senao se(n == 3){
      escreva("terça-feira")
    }
    
       senao se(n == 4){
      escreva("quarta-feira")
    }
      senao se(n == 5){
      escreva("quinta-feira")
    }
    
      senao se(n == 6){
      escreva("sexta-feira")
    }
       senao se(n == 7){
      escreva("sabado")
    }
      senao{
          escreva("de 1 a 7 🤨" )
      }
      





    
}
}
