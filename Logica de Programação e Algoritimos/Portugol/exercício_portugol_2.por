programa {
  funcao inicio() {

    real altura, raio, area, volume,pi=3.14

    escreva("digite o raio: ")
    leia(raio)

    escreva("digite altura: ")
    leia(altura)

    area=2*pi*(raio+altura)
    escreva("\n area = ",area)

    volume= pi*raio*raio*altura
    escreva("\n volume = ", volume)



    
  }
}
